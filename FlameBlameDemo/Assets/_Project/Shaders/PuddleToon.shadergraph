        {
            "m_Id": "e738040fc606821a7b0a3b3f290a00fe"
        },
        {
            "m_Id": "92ea7970f226609f6f7991c2b1f76824"
        },
        {
            "m_Id": "5c4b476b58a615380d04ea0e88f0dc5b"
        },
        {
            "m_Id": "1cd785c5a9784745e0a4120de12c0188"
        },
        {
            "m_Id": "229cb8c3c9a7f1b7c6fa1c058c325ccf"
        },
        {
            "m_Id": "05723e960c8ce5f89c5aa8d0bb689e6e"
        },
        {
            "m_Id": "2942463cf9a6ed951675c96f358c02c6"
        },
        {
            "m_Id": "da9e0d4124ba74cb6e6ab258d5c6135b"
        },
        {
            "m_Id": "1315d27811e8751a22dfb3b3516fc061"
        },
        {
            "m_Id": "4d7e09e6b30dfa7d1bddc1822eb5ff3f"
        }
    ],
    "m_Precision": 1,
    "m_SourceType": 1,
    "m_FunctionName": "PuddleSurface",
    "m_FunctionBody": "float t = _Time.y;\nfloat2 w = World.xz;\nfloat mask = MaskIndex < .5 ? SAMPLE_TEXTURE2D(Mask0.tex,Mask0.samplerstate,UV.xy).r : MaskIndex < 1.5 ? SAMPLE_TEXTURE2D(Mask1.tex,Mask1.samplerstate,UV.xy).r : MaskIndex < 2.5 ? SAMPLE_TEXTURE2D(Mask2.tex,Mask2.samplerstate,UV.xy).r : SAMPLE_TEXTURE2D(Mask3.tex,Mask3.samplerstate,UV.xy).r;\nfloat n = SAMPLE_TEXTURE2D(Noise.tex,Noise.samplerstate,w*1.4+t*EdgeSpeed+Seed).r;\nfloat edge = mask + (n-.5)*EdgeNoise*step(.01,mask);\nThreshold = lerp(1.08,.16,saturate(Fill));\nAlpha = edge;\nfloat depth = edge-Threshold;\nfloat2 drift=w*.65+float2(t*GlintSpeed,t*GlintSpeed*.4);\nfloat glint=step(.77,SAMPLE_TEXTURE2D(Noise.tex,Noise.samplerstate,drift).g);\nfloat wave=step(.65,sin(w.x*3+w.y*2-t*.65)*.5+.5);\nfloat3 water=lerp(WaterColor,DeepColor,step(.68,depth));\nwater+=wave*float3(.025,.06,.055);\nwater=lerp(water,RimColor,1-step(RimWidth,depth));\nwater=lerp(water,float3(1,.73,.07),Electrified*.85);\nColor=lerp(water,float3(.9,.98,.95),glint*.65);\nColor=lerp(Color,float3(.8,.88,.85),Steam*.3);\nGlow=glint*float3(.36,.44,.42)*(.85+.15*sin(t*2)) + Electrified*float3(.6,.35,.015)*(.55+.45*sin(t*32));",
    "m_ObjectId": "a511ea1218161d33f841ce3e208e3c1e"
}

